--wrapping it in pcall so it can warn if function failed
local success, result = pcall(function()
	MarketplaceService.ProcessReceipt = function(receiptInfo) -- this is where all the magic happens
		local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
		local gamepassId = receiptInfo.ProductId
		print(receiptInfo.ProductId)

		if not player or not player.Parent then -- if player left the game or somehow disappeared
			warn("Player not found")
			return Enum.ProductPurchaseDecision.NotProcessedYet, "player not found" -- stop proccess
		end

		local profile = Datahandler.GetProfile(player)
		if not profile then
			warn("Profile not found")
			return Enum.ProductPurchaseDecision.NotProcessedYet, "profile not found" -- return data and if not data also stop proccess
		end
		
		local isConsumable = CONSUMABLE_PRODUCTS[gamepassId] -- check if product is consumable
		local data = profile.Data.OtherData.Gamepasses -- get gamepasses data from profile
		
		if not isConsumable then -- gamepasses
			local success, haspass = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamepassId) -- check if player already has gamepass
			end)

			if not success then 
				warn("Error checking gamepass ownership", haspass)
				return Enum.ProductPurchaseDecision.NotProcessedYet, "error" -- return false not proccesing
			end

			if haspass or table.find(data, gamepassId) then -- check if player already has gamepass recorded in game profilestore or roblox backend
				warn("Player already owns gamepass")
				return Enum.ProductPurchaseDecision.NotProcessedYet, "already owns gamepass" -- return false not proccesing
			end
		end


		local handler = GamePassesHandler[gamepassId]
		if handler then
			local success, result = pcall(function(...)  -- make sure handler are being excuted
				local handlerresult, warning = handler(receiptInfo, player, ReciptHandler.TargetPlayer)
				if handlerresult == "fail" then -- handler failed return false
					warn("Error processing gamepass purchase", warning)
					return false, warning
				end
				
				return true-- success returns true
			end) 
			
			if not success then  -- anything stopped handler for example typo or wrong excution
				warn("Error processing gamepass purchase", result)
				return Enum.ProductPurchaseDecision.NotProcessedYet, "error"
			end
		else 
			warn("No handler for gamepass " .. gamepassId) -- no handlers for gamepass rarely if client side was done first
			return Enum.ProductPurchaseDecision.NotProcessedYet, "error"
		end
		
		if not isConsumable then
			table.insert(data, gamepassId)-- saves gamepass to profile
		end
		print(player.Name .. " has been granted gamepass " .. gamepassId)
		--Datahandler.SaveProfile(player, profile)
		return Enum.ProductPurchaseDecision.PurchaseGranted, "success" -- pursche procceded
	end
end)

if not success then
	warn("Error setting up ProcessPurchase function: " .. tostring(result))
end

function ReciptHandler.ProcessPurchase( player: Player, Productdata: {any}, callback: () -> ())
	local profile = Datahandler.GetProfile(player)
	local price = Productdata.price
	local name = Productdata.name

	if not profile then
		return false, "error"
	end

	local data = profile.Data.OtherData.Inventory
	local success, hasitem = pcall(function()
		return table.find(data, name)
	end)

	if hasitem then
		return false, "already owns item"
	end

	if profile.Data.OtherData.Cash < price then
		return false, "not enough cash"
	end

	profile.Data.OtherData.Cash -= price
	table.insert(profile.Data.OtherData.Inventory, name)
	print(player.Name .. " has been granted item " .. name)

	local success, result = pcall(callback)
	if not success then
		return false, result
	end

	print("purchase success")
	return true, "success"
end

