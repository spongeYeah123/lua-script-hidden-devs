-- Helper to get a player's profile data safely
local function getProfileData(player)
	local profile = Datahandler.GetProfile(player)-- profile store
	if not profile then return nil end
	return profile.Data -- return the data in profile store
end

-- Give a tool to a player, if they don't already have it
local function giveTool(player, toolName, folderName)
	local folder = ServerStorage:FindFirstChild(folderName)-- check if folder exists
	local tool = folder and folder:FindFirstChild(toolName) -- looks for the tool in folder
	if not tool then
		warn("Missing tool '" .. toolName .. "' in ServerStorage > " .. folderName)
		return "fail"
	end -- return fail if no tools 
	
	if player:FindFirstChild("StarterGear") and not player.StarterGear:FindFirstChild(toolName) then
		tool:Clone().Parent = player.StarterGear
	end
	
	if player:FindFirstChild("Backpack") and not player.Backpack:FindFirstChild(toolName) then
		tool:Clone().Parent = player.Backpack 
	end-- clone tool and give it in player gear and backpack
	
	
	Datahandler.AddItem(player, toolName) -- add tool to player inventory
	return "success"-- return success
end

