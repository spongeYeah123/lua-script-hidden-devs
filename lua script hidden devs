-- Oh no you fell: sends the target (or the buyer if no target) back to the spawn
GamePassesHandler[Settings.Gamepasses.OhNoYouFell] = function(receiptinfo: {any}, player: Player, target: Player)
	local victim = target or player
	local char = victim.Character
	if not char then return "fail", "Target has no character" end

	local spawnPart = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if not spawnPart then return "fail", "No SpawnLocation found in Workspace" end

	char:PivotTo(spawnPart.CFrame + Vector3.new(0, 5, 0))
	print(victim.Name .. " has been sent back to the start")
	return "success", "Sent back to start"
end

-- Go to end: teleports the buyer to the end of the tower
GamePassesHandler[Settings.Gamepasses.GoToEnd] = function(receiptinfo: {any}, player: Player)
	local char = player.Character
	if not char then return "fail", "Player has no character" end

	local tower = workspace:FindFirstChild("Tower")
	local endPart = workspace:FindFirstChild("EndPart", true)
		or (tower and tower:FindFirstChild("Wins"))
	if not endPart then return "fail", "No EndPart or Tower.Wins found in Workspace" end

	char:PivotTo(endPart.CFrame + Vector3.new(0, 5, 0))
	print(player.Name .. " has been teleported to the end")
	return "success", "Teleported to the end"
end

-- utility gamepasses
GamePassesHandler[Settings.Gamepasses.Freeze] = function(receiptinfo: {any}, player: Player, target: Player)
	if not target then  warn("Notarget") return "fail", "No Target Found" end -- no target return fail
	local TargetHum = target.Character:FindFirstChildOfClass("Humanoid")
	if not TargetHum then warn("No target hum") return "fail", "Target Dont exists"end -- somehow target doesnt have character or hun return fail
	
	local Config = Settings.GamePassesConfig.Freeze -- Config for gamepasses from another module
	local FreezePart = Instance.new("Part", workspace:WaitForChild("Dump")) -- place for all temprory garbage parts
	FreezePart.Name = "FreezePart"
	FreezePart.Anchored = true -- part not defined by physics
	FreezePart.CanCollide = false -- dont want character to be glitching 
	FreezePart.Transparency = 0.4 -- transparency
	local Size = Config.Size -- config size
	FreezePart.Size = Vector3.new(Size.X, Size.Y, Size.Z) --config size
	FreezePart.Color = Color3.fromRGB(85, 170, 255) -- blue
	FreezePart.Material  = Enum.Material.Ice
	FreezePart.MaterialVariant = "Ice"
	
	local function Freeze() -- checks for target returns  fail if no target then stun the player and create ice block around him
		local CurrentSpeed = TargetHum.WalkSpeed  -- saves current speed
		local CurrentJumpPower = TargetHum.JumpPower-- saves current jump
		
		TargetHum.WalkSpeed = 0 -- stun
		TargetHum.JumpPower = 0 -- stun
		FreezePart.CFrame = target.Character:GetPivot() -- set CFrame to character pivot so it become accuratly placed
		task.delay(Config.FreezeTime, function() -- after cooldown reset player stats
			if TargetHum and TargetHum.Parent then
				TargetHum.WalkSpeed = CurrentSpeed
				TargetHum.JumpPower = CurrentJumpPower
			end
			if FreezePart and FreezePart.Parent then
				FreezePart:Destroy()
			end
		end)
	end
	
	Freeze()-- call function
	return "success", "Freeze"
end

